{
  "name": "desktop-mate",
  "version": "0.1.0",
  "private": true,
  "author": "Desktop Mate Project",
  "description": "Advanced native desktop companion",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.json",
    "build:renderer": "vite build --config vite.config.ts",
    "test": "node scripts/run-tests.mjs",
    "validate:avatar": "node scripts/validate-avatar-asset.mjs",
    "validate:packaged-assets": "node scripts/validate-packaged-assets.mjs",
    "qa:ai": "node --import tsx scripts/ai-provider-e2e.ts",
    "start": "electron .",
    "dev": "electron .",
    "perf": "node scripts/perf-check.mjs",
    "package:dir": "npm run build && electron-builder --dir --publish never",
    "package": "npm run build && electron-builder --publish never"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "three": "^0.178.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/three": "^0.178.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^7.0.6"
  },
  "build": {
    "appId": "com.desktopmate.companion",
    "productName": "Desktop Mate",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "linux": {
      "target": ["AppImage"],
      "category": "Utility"
    },
    "win": {
      "target": ["nsis"],
      "artifactName": "Desktop-Mate-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": ["dmg"]
    }
  }
}
